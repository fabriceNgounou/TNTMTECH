# ---------------------------------------------------------------------------
# Variables à définir sur le service Railway (onglet « Variables »).
# Ce fichier sert de référence : Railway n'utilise pas de fichier .env.
# ---------------------------------------------------------------------------

APP_NAME=TNTMTECH
APP_ENV=production
APP_DEBUG=false

# Générez la clé en local avec :  php artisan key:generate --show
# puis collez la valeur complète, préfixe « base64: » compris.
APP_KEY=

# Renseignez le domaine fourni par Railway, puis votre domaine définitif.
APP_URL=https://votre-service.up.railway.app

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Douala

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Base de données MySQL -------------------------------------------------
# Utilisez les références Railway : elles se mettent à jour automatiquement
# si la base est recréée. Saisissez-les telles quelles, accolades comprises.
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# --- Sessions, cache et files d'attente ------------------------------------
# Stockés en base : le disque du conteneur est éphémère sur Railway.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Courriel ---------------------------------------------------------------
# « log » écrit les messages dans les journaux sans rien envoyer.
# Renseignez un vrai SMTP pour que les formulaires envoient des courriels.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=contact@tntmtech.cm
MAIL_FROM_NAME=TNTMTECH
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# --- Compte administrateur --------------------------------------------------
# Utilisé par le seeder. Choisissez impérativement un mot de passe fort :
# le mot de passe par défaut du dépôt est public.
ADMIN_NAME=Administrateur TNTMTECH
ADMIN_EMAIL=admin@tntmtech.cm
ADMIN_PASSWORD=

# Mettez à true pour le tout premier déploiement afin de créer le compte
# administrateur et les contenus de départ, puis repassez à false.
RUN_SEEDERS=false

# --- Coordonnées TNTMTECH ---------------------------------------------------
TNTMTECH_WHATSAPP_DOUALA=237676388135
TNTMTECH_WHATSAPP_YAOUNDE=237650600990
TNTMTECH_WHATSAPP_FRANCE=33756992282
TNTMTECH_EMAIL=contact@tntmtech.cm
